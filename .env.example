# Server-side only. Set this in Netlify site environment variables for deploys.
GEMINI_API_KEY=
GEMINI_VOICE=Kore
PORT=3001
NODE_ENV=development
# Legacy prototype endpoints only; active receptionist data uses Netlify Postgres.
DATABASE_PATH=./data/health-voice-agent.sqlite
# NETLIFY_DB_URL is supplied by Netlify Database in Netlify Functions and local dev.
# Do not commit a database connection string here.
